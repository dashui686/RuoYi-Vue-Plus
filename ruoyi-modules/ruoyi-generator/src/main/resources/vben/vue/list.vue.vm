<script lang="ts" setup>
import type {
  OnActionClickParams,
  VxeTableGridOptions,
} from '#/adapter/vxe-table';
import type { ${BusinessName}VO } from '#/api/${moduleName}/${businessName}';

import { Page, useVbenModal } from '@vben/common-ui';
import { Plus } from '@vben/icons';

import { Button, message, Upload } from 'ant-design-vue';

import { useVbenVxeGrid } from '#/adapter/vxe-table';
import {
  useBatchDelete,
  useGridSelection,
} from '#/composables/useGridHelper';
import {
  del${BusinessName},
  export${BusinessName},
  importTemplate,
  list${BusinessName},
} from '#/api/${moduleName}/${businessName}';
import { $t } from '#/locales';

import { useColumns, useGridFormSchema } from './data';
import Form from './modules/form.vue';

const [FormModal, formModalApi] = useVbenModal({
  connectedComponent: Form,
  destroyOnClose: true,
});

const { deleteDisabled, editDisabled, gridEvents, onToolbarEdit } =
  useGridSelection<${BusinessName}VO>(() => gridApi);

const { onBatchDelete } = useBatchDelete(
  () => gridApi,
  del${BusinessName},
  '${pkColumn.javaField}',
);

const [Grid, gridApi] = useVbenVxeGrid({
  gridEvents,
  formOptions: {
    schema: useGridFormSchema(),
    submitOnChange: true,
    submitOnEnter: true,
  },
  gridOptions: {
    columns: useColumns(onActionClick),
    height: 'auto',
    keepSource: true,
    pagerConfig: { enabled: true },
    proxyConfig: {
      ajax: {
        query: async ({ page }, formValues) => {
          return await list${BusinessName}({
            pageNum: page.currentPage,
            pageSize: page.pageSize,
            ...formValues,
          });
        },
      },
    },
    rowConfig: { keyField: '${pkColumn.javaField}' },
    toolbarConfig: {
      custom: true,
      export: false,
      refresh: true,
      search: true,
      zoom: true,
    },
  } as VxeTableGridOptions<${BusinessName}VO>,
});

function onActionClick({ code, row }: OnActionClickParams<${BusinessName}VO>) {
  if (code === 'edit') onEdit(row);
  else if (code === 'delete') onDelete(row);
}

function onEdit(row: ${BusinessName}VO) {
  formModalApi.setData(row).open();
}

function onCreate() {
  formModalApi.setData({}).open();
}

async function onDelete(row: ${BusinessName}VO) {
  try {
    await del${BusinessName}(String(row.${pkColumn.javaField}));
    message.success($t('ui.actionMessage.deleteSuccess', [row.${columns.get(0).javaField}]));
    gridApi.query();
  } catch {}
}

async function onExport() {
  const formValues = await gridApi.formApi.getValues();
  await export${BusinessName}(formValues);
  message.success('导出成功');
}

function onImport(info: { file: File }) {
  const formData = new FormData();
  formData.append('file', info.file);
  importTemplate(formData).then(() => {
    message.success('导入成功');
    gridApi.query();
  });
}
</script>

<template>
  <Page auto-content-height>
    <FormModal @success="gridApi.query()" />
    <Grid :table-title="$t('${moduleName}.${businessName}.list')">
      <template #toolbar-tools>
        <Button v-access:code="'${permissionPrefix}:add'" type="primary" @click="onCreate">
          <Plus class="size-5" />
          {{ $t('ui.actionTitle.create', [$t('${moduleName}.${businessName}.name')]) }}
        </Button>
        <Button
          v-access:code="'${permissionPrefix}:edit'"
          :disabled="editDisabled"
          style="margin-left: 8px"
          @click="onToolbarEdit(onEdit)"
        >
          {{ $t('common.edit') }}
        </Button>
        <Button
          v-access:code="'${permissionPrefix}:remove'"
          :disabled="deleteDisabled"
          danger
          style="margin-left: 8px"
          @click="onBatchDelete"
        >
          {{ $t('common.delete') }}
        </Button>
        <Upload
          v-access:code="'${permissionPrefix}:import'"
          :custom-request="onImport"
          :show-upload-list="false"
          style="margin-left: 8px"
        >
          <Button>{{ $t('common.import') }}</Button>
        </Upload>
        <Button
          v-access:code="'${permissionPrefix}:export'"
          style="margin-left: 8px"
          @click="onExport"
        >
          {{ $t('common.export') }}
        </Button>
      </template>
    </Grid>
  </Page>
</template>
